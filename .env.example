# Neon / Postgres (Vercel Marketplace inietta DATABASE_URL; locale usa POSTGRES_URL o DATABASE_URL)
DATABASE_URL=postgresql://user:password@host.neon.tech/edareview?sslmode=require
POSTGRES_URL=postgresql://postgres@127.0.0.1:54320/edareview

# Payload CMS
PAYLOAD_SECRET=genera-stringa-random-lunga

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# App URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel): https://edareview.vercel.app

# Metadata API (server-side only, Fase 3)
TMDB_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Opzionali (template Payload)
CRON_SECRET=
PREVIEW_SECRET=

# Observability (opzionale — Fase 8)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
